# Skot whiteboard environment variables
# Copy to .env.local for local development.

# Optional: Server-side API key for TypeSafe AI's System One model
# Endpoint: POST https://api.typesafe.ai/v1/systemone
# When unset, /api/jev/decide uses the calibrated local fallback with zero errors.
TYPESAFE_API_KEY=

# Optional: Structured JSON LLM key for rich graph generation, Fork It! takes,
# Notation Morph refinement, and Talk-to-Draw parsing.
# JEV_LLM_API_KEY takes precedence over OPENAI_API_KEY. When unset, Skot runs
# deterministically in honest "Heuristic" mode with zero errors.
JEV_LLM_API_KEY=
OPENAI_API_KEY=
# Optional HTTPS endpoint & model overrides for OpenAI-compatible structured JSON LLMs
# Defaults: https://api.openai.com/v1/chat/completions and gpt-4o-mini
JEV_LLM_BASE_URL=
JEV_LLM_MODEL=

# Optional: Global upstream spend caps for /api/jev/decide when API keys are set.
# When exhausted, /api/jev/decide skips upstream calls and returns honest heuristic fallback.
# Defaults: 120 per minute, 5000 per day.
JEV_UPSTREAM_MAX_PER_MINUTE=
JEV_UPSTREAM_MAX_PER_DAY=

# Proxy IP trust mode for rate limiting & per-IP signaling room caps.
# REQUIRED in production (NODE_ENV=production): API routes fail fast with 503 if unset.
# Allowed values:
# - "cloudflare": trusts CF-Connecting-IP ONLY (always ignores X-Forwarded-For).
# - "none": ignores proxy headers; in production requires a direct peer IP or ALLOW_SINGLE_USER_LOCAL=1.
TRUST_PROXY=
# Optional: Set to "1" with TRUST_PROXY=none ONLY for single-user local production runs without a reverse proxy.
ALLOW_SINGLE_USER_LOCAL=

# Optional: Dynamic WebRTC STUN/TURN server configuration served via GET /api/ice-config
# (Cache-Control: no-store). Static TURN credentials are never exposed publicly.
# Option A (STUN-only custom list): JSON array of STUN RTCIceServer objects:
#   ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
ICE_SERVERS_JSON=

# Option B (Authenticated short-lived coturn HMAC TURN):
# Comma-separated TURN/STUN URLs + coturn `static-auth-secret` (`use-auth-secret`).
# TURN credentials (10 min TTL HMAC-SHA1) are minted ONLY for peers authenticated with
# room + x-room-secret + x-peer-token against the signaling store; unauthenticated callers get STUN-only.
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
TURN_SHARED_SECRET=
