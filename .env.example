# Jev Whiteboard environment variables
# Copy to .env.local for local development. All variables are optional.

# Optional: Server-side API key for TypeSafe AI's System One model (Jev)
# Endpoint: POST https://api.typesafe.ai/v1/systemone
# When unset, /api/jev/decide uses the calibrated local fallback with zero errors.
TYPESAFE_API_KEY=

# Optional: Global upstream spend caps for /api/jev/decide when TYPESAFE_API_KEY is set.
# When exhausted, /api/jev/decide skips upstream calls and returns honest heuristic fallback.
# Defaults: 120 per minute, 5000 per day.
JEV_UPSTREAM_MAX_PER_MINUTE=
JEV_UPSTREAM_MAX_PER_DAY=

# Optional: Proxy IP trust mode for rate limiting & per-IP signaling room caps.
# Allowed values: "none" (default — ignores X-Forwarded-For & CF-Connecting-IP) or
# "cloudflare" (trusts CF-Connecting-IP ONLY; always ignores X-Forwarded-For).
TRUST_PROXY=

# Optional: Dynamic WebRTC STUN/TURN server configuration served via GET /api/ice-config
# (Cache-Control: no-store) so TURN credentials are never baked into client bundles.
# Option A: Full JSON array of RTCIceServer objects:
#   ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
ICE_SERVERS_JSON=

# Option B: Comma-separated TURN/STUN URLs + credentials (automatically paired with default Google STUN):
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
